{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/corbett-enrichment.mjs && vite build && node scripts/generate-corbett-pages.mjs && node scripts/generate-product-pages.mjs && node scripts/inject-seo-contact-layer.mjs",
    "build:app": "node scripts/corbett-enrichment.mjs && vite build && node scripts/generate-corbett-pages.mjs",
    "build:seo": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "seo:validate": "node scripts/seo-validate.mjs",
    "corbett:seo:validate": "node scripts/corbett-seo-validate.mjs",
    "corbett:enrichment:refresh": "node scripts/corbett-enrichment.mjs",
    "corbett:enrichment:import": "node scripts/corbett-enrichment.mjs --import",
    "test:seo": "node --test scripts/seo-quality.test.mjs scripts/corbett-data.test.mjs scripts/corbett-authority.test.mjs scripts/corbett-enrichment.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "terser": "^5.44.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.5"
  }
}
