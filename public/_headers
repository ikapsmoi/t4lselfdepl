# Cache fingerprinted Vite assets for one year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Optimized images are regenerated with the application build.
/optimized/*
  Cache-Control: public, max-age=2592000

# Cache public image files for one month.
/*.jpg
  Cache-Control: public, max-age=2592000

/*.jpeg
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/trip-city-images/*
  Cache-Control: public, max-age=2592000

/trip-thumbnails/*
  Cache-Control: public, max-age=2592000

# Revalidate HTML frequently so deployments and inventory updates appear promptly.
/
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/trips/*
  Cache-Control: public, max-age=300, must-revalidate

/jim-corbett/*
  Cache-Control: public, max-age=300, must-revalidate
